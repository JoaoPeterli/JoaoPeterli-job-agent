<% content_for :title, "Painel" %>

<div class="page" data-controller="refresh" data-refresh-active-value="<%= @runs.any? { |run| run_active?(run) } || @stats[:active].positive? %>">
  <%= render "shared/page_header", title: "Painel", description: "Acompanhe as buscas do agente: status, custo e resultado de cada run." do %>
    <%= link_to new_run_path, class: "button button--primary" do %>
      <%= icon("plus") %> Nova busca
    <% end %>
  <% end %>

  <div class="kpis">
    <%= render "shared/kpi", label: "Runs", value: format_count(@stats[:total]), icon_name: "activity",
                             hint: @stats[:active].positive? ? "#{@stats[:active]} em andamento" : "nenhum em andamento" %>
    <%= render "shared/kpi", label: "Taxa de sucesso", value: format_percent(@stats[:success_rate]), icon_name: "circle-check",
                             hint: "dos runs finalizados" %>
    <%= render "shared/kpi", label: "Tokens consumidos", value: format_count(@stats[:total_tokens]), icon_name: "cpu",
                             hint: "soma de todos os runs" %>
    <%= render "shared/kpi", label: "Duração média", value: format_duration(@stats[:avg_duration_ms]), icon_name: "clock",
                             hint: "dos runs finalizados" %>
  </div>

  <section class="card">
    <div class="card__header card__header--split">
      <div>
        <h2 class="card__title">Runs recentes</h2>
        <p class="card__description">Os <%= RunsController::RECENT_RUNS %> mais recentes. A lista atualiza sozinha enquanto há run em andamento.</p>
      </div>
      <nav class="tabs" aria-label="Filtrar por status">
        <% RunsHelper::FILTER_LABELS.each do |filter, label| %>
          <%= link_to label, runs_path(status: filter), class: "tabs__item", aria: { current: @filter == filter ? "page" : nil } %>
        <% end %>
      </nav>
    </div>

    <% if @runs.empty? %>
      <%= render "shared/empty_state", icon_name: "inbox",
                 title: @filter ? "Nenhum run com este status" : "Nenhuma busca ainda",
                 message: @filter ? "Troque o filtro para ver os outros runs." : "Descreva a vaga que você procura e o agente faz o resto." do %>
        <% unless @filter %>
          <%= link_to new_run_path, class: "button button--primary" do %><%= icon("plus") %> Nova busca<% end %>
        <% end %>
      <% end %>
    <% else %>
      <div class="table-container">
        <table class="table">
          <thead>
            <tr>
              <th scope="col">Objetivo</th>
              <th scope="col" class="hide-sm">Modo</th>
              <th scope="col" class="hide-sm">Status</th>
              <th scope="col" class="num hide-sm">Duração</th>
              <th scope="col" class="num hide-sm">Tokens</th>
              <th scope="col" class="num hide-sm">Quando</th>
            </tr>
          </thead>
          <tbody>
            <% @runs.each do |run| %>
              <tr>
                <td class="table__primary">
                  <%= link_to run.objective, run_path(run), class: "row-link" %>
                  <span class="show-sm table__meta table__meta--row"><%= status_badge(run.status) %><%= l(run.created_at, format: "%d/%m %H:%M") %></span>
                </td>
                <td class="hide-sm"><span class="mode-tag"><%= mode_icon(run.mode) %><%= mode_label(run.mode) %></span></td>
                <td class="hide-sm"><%= status_badge(run.status) %></td>
                <td class="num hide-sm"><%= format_duration(run.metrics["duration_ms"]) %></td>
                <td class="num hide-sm"><%= format_count(run.metrics["total_tokens"]) %></td>
                <td class="num muted nowrap hide-sm"><%= l(run.created_at, format: "%d/%m %H:%M") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>
</div>
