<% content_for :title, @run.objective.truncate(40) %>

<div class="page" data-controller="refresh" data-refresh-active-value="<%= run_active?(@run) %>">
  <%= link_to runs_path, class: "back-link" do %><%= icon("arrow-left") %> Voltar ao painel<% end %>

  <div class="page-header">
    <div class="page-header__text">
      <p class="eyebrow"><span class="mode-tag"><%= mode_icon(@run.mode) %><%= mode_label(@run.mode) %></span> · tentativa <%= @run.attempts %> · <%= l(@run.created_at, format: "%d/%m/%Y %H:%M") %></p>
      <h1 class="page-header__title page-header__title--wrap"><%= @run.objective %></h1>
    </div>
    <div class="page-header__actions">
      <%= status_badge(@run.status) %>
      <% if run_active?(@run) %>
        <%= button_to cancel_run_path(@run), class: "button button--destructive-outline", disabled: @run.cancel_requested?,
                      form: { data: { turbo_confirm: "Cancelar este run?" } } do %>
          <%= icon("ban") %> Cancelar
        <% end %>
      <% end %>
      <%= button_to redo_run_path(@run), class: "button button--outline",
                    form: { data: { turbo_confirm: "Refazer esta busca? Cria um run novo e chama a OpenAI de novo." } } do %>
        <%= icon("rotate-ccw") %> Refazer busca
      <% end %>
      <% if @run.deleted? %>
        <%= button_to restore_run_path(@run), class: "button button--outline" do %>
          <%= icon("undo") %> Restaurar
        <% end %>
      <% elsif @run.finished? %>
        <%= button_to run_path(@run), method: :delete, class: "button button--destructive-outline",
                      form: { data: { turbo_confirm: "Mover este run para a lixeira? Dá para restaurar depois." } } do %>
          <%= icon("trash") %> Excluir
        <% end %>
      <% end %>
    </div>
  </div>

  <% if @run.deleted? %>
    <div class="alert alert--warning" role="status">
      <%= icon("trash") %>
      <p>Este run está na lixeira desde <%= l(@run.deleted_at, format: "%d/%m/%Y %H:%M") %>. Ele não aparece no painel nem conta nos indicadores.</p>
    </div>
  <% end %>

  <% if run_active?(@run) %>
    <div class="alert alert--info" role="status">
      <%= icon("loader", class_name: "spin") %>
      <p>
        <%= @run.status == "queued" ? "Aguardando um worker…" : "Trabalhando… esta página atualiza sozinha." %>
        <% if @run.cancel_requested? %><strong>Cancelamento pedido.</strong><% end %>
      </p>
    </div>
  <% end %>

  <% if @run.error_class.present? %>
    <div class="alert alert--danger" role="alert">
      <%= icon("circle-alert") %>
      <p>O run terminou com erro: <code><%= @run.error_class %></code></p>
    </div>
  <% end %>

  <div class="kpis kpis--five">
    <%= render "shared/kpi", label: "Duração", value: format_duration(@run.metrics["duration_ms"]), icon_name: "clock" %>
    <%= render "shared/kpi", label: "Chamadas ao LLM", value: format_count(@run.metrics["llm_calls"]), icon_name: "sparkles" %>
    <%= render "shared/kpi", label: "Tokens", value: format_count(@run.metrics["total_tokens"]), icon_name: "cpu" %>
    <%= render "shared/kpi", label: "Custo", value: (@run.metrics.key?("cost_usd") ? format_cost(@run.metrics["cost_usd"]) : "—"), icon_name: "coins" %>
    <%= render "shared/kpi", label: "Ferramentas", value: format_count(@run.metrics["tool_calls"]), icon_name: "wrench" %>
  </div>

  <section class="card">
    <div class="card__header">
      <h2 class="card__title">Vagas <span class="count"><%= @jobs.size %></span></h2>
      <p class="card__description">
        Ordenadas pela aderência ao seu perfil. Clique na vaga para abrir o anúncio original.
        <% if (sources = JobSearch::JobSources.attributions).any? %>
          Fontes: <%= safe_join(sources.map { |source| link_to(source[:name], source[:url], target: "_blank", rel: "noopener", class: "text-link") }, ", ") %>.
        <% end %>
      </p>
    </div>

    <% if @jobs.empty? %>
      <%= render "shared/empty_state", icon_name: "briefcase",
                 title: @run.finished? ? "Nenhuma vaga neste run" : "Ainda procurando",
                 message: @run.finished? ? "Tente um objetivo mais amplo." : "As vagas aparecem aqui quando o run terminar." %>
    <% else %>
      <div class="table-container">
        <table class="table">
          <thead>
            <tr>
              <th scope="col">Vaga</th>
              <th scope="col" class="hide-sm">Fonte</th>
              <th scope="col" class="hide-sm">Modalidade</th>
              <th scope="col" class="hide-sm">Publicada</th>
              <th scope="col">Aderência</th>
            </tr>
          </thead>
          <tbody>
            <% @jobs.each do |job| %>
              <tr>
                <td class="table__primary table__primary--wrap">
                  <%= job_title_link(job) %>
                  <span class="table__meta"><%= [ job["company"], job["location"] ].compact_blank.join(" · ").presence || "—" %></span>
                  <span class="show-sm table__meta"><%= [ job["source"], job["remote"] ? "Remota" : "Presencial", job_published(job) ].compact_blank.join(" · ") %></span>
                </td>
                <td class="hide-sm muted nowrap"><%= job["source"].presence || "—" %></td>
                <td class="hide-sm">
                  <% if job["remote"] %>
                    <span class="badge badge--info"><%= icon("globe") %>Remota</span>
                  <% else %>
                    <span class="badge badge--neutral">Presencial</span>
                  <% end %>
                </td>
                <td class="hide-sm muted nowrap"><%= job_published(job) || "—" %></td>
                <td>
                  <% if job.key?("score") %>
                    <span class="score">
                      <span class="score__track"><span class="score__bar" style="<%= score_width(job["score"]) %>"></span></span>
                      <span class="score__value"><%= job["score"] %></span>
                    </span>
                  <% else %>
                    <span class="muted">—</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>

  <div class="split split--even">
    <% if @run.result["agents"].present? %>
      <section class="card">
        <div class="card__header">
          <h2 class="card__title">Agentes do time</h2>
          <p class="card__description">Na ordem em que o supervisor delegou.</p>
        </div>
        <ol class="agent-list">
          <% @run.result["agents"].each_with_index do |agent, index| %>
            <li class="agent-list__item">
              <span class="agent-list__index"><%= index + 1 %></span>
              <span class="agent-list__text">
                <strong><%= agent["delegation"] %></strong>
                <code class="muted"><%= agent["run_id"] %></code>
              </span>
            </li>
          <% end %>
        </ol>
      </section>
    <% end %>

    <section class="card">
      <div class="card__header card__header--split">
        <div>
          <h2 class="card__title">Auditoria</h2>
          <p class="card__description">Eventos encadeados por hash, só de inserção.</p>
        </div>
        <% if @audit_events.any? %>
          <% if @audit_check.valid? %>
            <span class="badge badge--success"><%= icon("shield-check") %>cadeia íntegra</span>
          <% else %>
            <span class="badge badge--danger"><%= icon("shield-alert") %>cadeia violada no evento <%= @audit_check.broken_at_seq %></span>
          <% end %>
        <% end %>
      </div>

      <% if @audit_events.empty? %>
        <%= render "shared/empty_state", icon_name: "shield-check", title: "Sem eventos ainda" %>
      <% else %>
        <ol class="timeline">
          <% @audit_events.each do |event| %>
            <li class="timeline__item timeline__item--<%= event.outcome %>">
              <span class="timeline__dot" aria-hidden="true"></span>
              <span class="timeline__event"><%= event.event %></span>
              <span class="timeline__outcome"><%= event.outcome %></span>
              <time class="timeline__time" datetime="<%= event.created_at.iso8601 %>"><%= l(event.created_at, format: "%H:%M:%S") %></time>
            </li>
          <% end %>
        </ol>
      <% end %>
    </section>
  </div>
</div>
