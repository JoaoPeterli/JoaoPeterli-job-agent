<div class="empty-state">
  <span class="empty-state__icon"><%= icon(icon_name) %></span>
  <p class="empty-state__title"><%= title %></p>
  <% if local_assigns[:message].present? %><p class="empty-state__message"><%= message %></p><% end %>
  <% actions = block_given? ? yield : nil %>
  <% if actions.present? %><div class="empty-state__actions"><%= actions %></div><% end %>
</div>
